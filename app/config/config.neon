parameters:


application:
	errorPresenter: Err:Error
	mapping:
		*: *Module\*Presenter


session:
	expiration: 14 days


services:
	- App\Model\UserManager
	- App\Model\Repository\UserRepository
	- App\Model\Repository\ZamestnanecRepository
	- App\Model\Repository\OsobaRepository
	- App\Components\IZamestnanecControlFactory
	- App\Forms\ZamestnanecForm
	- App\Model\Repository\WRRepository
	- App\Model\Repository\PohledRepository
	- App\Model\Repository\HlaseniRepository
	- App\Components\IWRControlFactory
	- App\Components\IHlaseniControlFactory
	- App\Forms\WRForm
	- App\Model\Repository\MzdovyComRepository
	- App\Components\IMzdovyComControlFactory
	- App\Forms\HlaseniForm
	- App\Forms\MzdovyComForm
	- App\Model\Repository\MzdovyParRepository
	- App\Components\IMzdovyParControlFactory
	- App\Forms\MzdovyParForm
	- App\Components\IRozpadstrediskaControlFactory
	- App\Components\IPohledControlFactory
	router: App\RouterFactory::createRouter
	authorizator: App\Model\Security\PermissionFactory::create()
