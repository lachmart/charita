		<!doctype html>
		<html class="no-js" lang="en">
		<head>
			<meta charset="utf-8">
			<meta http-equiv="x-ua-compatible" content="ie=edge">
			<meta name="viewport" content="width=device-width, initial-scale=1.0">

			<title>{ifset title}{include title|striptags}{/ifset} | File</title>

			<link rel="shortcut icon" href="{$basePath}/favicon.ico">
			<link href="{$basePath}/css/bootstrap.min.css" rel="stylesheet">

			<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.6.1/css/all.css" integrity="sha384-gfdkjb5BdAXd+lj+gudLWI+BXq4IuLW5IT+brZEZsLFm++aCMlF1V92rMkPaX4PP" crossorigin="anonymous">

			{block head}{/block}

			<link rel="stylesheet" href="{$basePath}/css/styles.css">



				<!-- Use this css for that pretty checkboxes (https://github.com/paveljanda/happy) -->
				<link rel="stylesheet" type="text/css" href="{$basePath}/css/happy.min.css">
				<link rel="stylesheet" type="text/css" href="{$basePath}/css/bootstrap-datepicker3.min.css">
				<link rel="stylesheet" type="text/css" href="{$basePath}/css/datagrid.css">

				<!-- Use this css for ajax spinners -->
				<link rel="stylesheet" type="text/css" href="{$basePath}/css/datagrid-spinners.css">

			<!-- Include this css when using FilterMultiSelect (silviomoreto.github.io/bootstrap-select) -->
				<link rel="stylesheet" type="text/css" href="{$basePath}/css/bootstrap-select.css">
		</head>

		<body>



		<div id="administration" class="wrapper">


			{if $user->isLoggedIn()}


				<!-- Sidebar -->
				<nav id="sidebar">

					<div class="sidebar-header">
						<h3>Charita <small> / krabička</small></h3>
					</div>

					<ul class="list-unstyled components">
						{* <li n:class="$presenter->isLinkCurrent('Homepage:*') ? active">
							<a href="{link Homepage:}">Dashboard</a>
						</li> *}
								  <li n:class="$presenter->isLinkCurrent('Zamestnanec:*') ? active">
								<a href="{link Zamestnanec:}">Zaměstnanci</a>
					  </li>
					</li>
								<li n:class="$presenter->isLinkCurrent('WR:*') ? active">
							<a href="{link WR:}">Pracovní poměry</a>
					</li>
				</li>
							<li n:class="$presenter->isLinkCurrent('MzdovyCom:*') ? active">
						<a href="{link MzdovyCom:}">Mzdové listy souhrnné</a>
				</li>
							<li n:class="$presenter->isLinkCurrent('Pohled:default') ? active">
						<a href="{link Pohled:default}">Pohled 1</a>
				</li>
							<li n:class="$presenter->isLinkCurrent('Pohled:hlaseni') ? active">
						<a href="{link Pohled:hlaseni}">Hlášení</a>
				</li>

		{* 	            <li>
							<a href="#pageSubmenu" data-toggle="collapse" aria-expanded="false" class="dropdown-toggle">Pages</a>
							<ul class="collapse list-unstyled" id="pageSubmenu">
								<li>
									<a href="#">Page 1</a>
								</li>
								<li>
									<a href="#">Page 2</a>
								</li>
								<li>
									<a href="#">Page 3</a>
								</li>
							</ul>
						</li> *}
					</ul>

					<div id="copy" class="p-3">
						<p>Martin Lach<br>
						lachmart@skaut.cz
						<p>© TechTailors s.r.o.</p>
					</div>


				</nav>


		{* 	    <div class="row pt-5 mb-3 pb-2">

					<div class="col-8 mx-auto">
						<div class="border-bottom">
							<div class="row">
								<div class="col-md-8">
								  <div class="page-header mb-3">
									<h1>file <small> / správa webu</small></h1>

									<p class="h6"><a n:href="Homepage:default">Administrace</a>{block breadcrumbs}{/block}</p>

								  </div>
								</div>
								<div class="col-md-4 pt-3 text-right">
								  {if $user->loggedIn}
									  <a class="btn btn-outline-primary" n:href="Sign:out">Odhlásit {ifset username}{include username}{/ifset}<i class="fas fa-sign-out-alt"></i></a>
								  {/if}
								</div>
							</div>
						</div>
					</div>

				</div> *}

			{/if}





			<div id="content" class="p-5 w-100">
				{if $user->isLoggedIn()}
					<nav class="navbar navbar-expand-lg navbar-light bg-light">
						<div class="container-fluid">

							<button type="button" id="sidebarCollapse" class="btn btn-info">
								<i class="fas fa-align-left"></i>
								<span>Toggle Sidebar</span>
							</button>

							<div class="collapse navbar-collapse" id="navbarSupportedContent">
								<ul class="nav navbar-nav ml-auto">
									<li class="nav-item active" style="padding-right:50px;">
										{if $user->loggedIn}
											<small>Přihlášen:</small><big> {$user->getIdentity()->userName}</big>
										{/if}
									</li>
									<li class="nav-item active">
									  {if $user->loggedIn}
										  <a class="btn btn-outline-secondary" n:href="Sign:out">Odhlásit {ifset username}{include username}{/ifset}<i class="fas fa-sign-out-alt"></i></a>
									  {/if}
									</li>
								</ul>
							</div>


						</div>
					</nav>

				{/if}

				{if count($flashes) > 0}
					<div class="w-50">
						<div n:foreach="$flashes as $flash" n:class="flash, alert, $flash->type">{$flash->message}</div>
					</div>
				{/if}

				{include content}


			</div>











		</div>






			{snippet modal}
					{if $presenter->isAjax()}
						{ifset #modal}
							<div class="modal fade modal-ajax" tabindex="" role="dialog">
							  <div class="modal-dialog "  role="document">
								<div class="modal-content">
									{block modalHeader}
									  <div class="modal-header">
										<h5 class="modal-title">{block|striptags}{include #modalTitle}{/block}</h5>
										<button type="button" class="close" data-dismiss="modal" aria-label="Close">
										  <span aria-hidden="true">&times;</span>
										</button>
									  </div>
									{/block}
								  <div class="modal-body">
									{include #modal}
								  </div>
									{ifset #modalFooter}
										<div class="modal-footer">
											{include #modalFooter}
										</div>
									{/ifset}
								</div>
							  </div>
							</div>
						{/ifset}
					{/if}
			{/snippet}



				<script src="{$basePath}/js/jquery.min.js"></script>
				<script src="{$basePath}/js/popper.min.js"></script>
				<script src="{$basePath}/js/bootstrap.min.js"></script>
				<script src="{$basePath}/js/nette.ajax.js"></script>
				<script src="{$basePath}/js/netteForms.min.js"></script>

				<script src="{$basePath}/js/scripts.js"></script>
				<script src="{$basePath}/js/bootstrap-datepicker.js"></script>
				<script src="{$basePath}/js/jquery-ui-sortable.js"></script>
			<script src="{$basePath}/js/datagrid.js"></script>
			<!-- It is recommended to include this JS file with just a few bits. It refreshes URL on non ajax request -->
			<script src="{$basePath}/js/datagrid-instant-url-refresh.js"></script>

			<!-- Use this little extension for ajax spinners -->
			<script src="{$basePath}/js/datagrid-spinners.js"></script>

			<!-- Include bootstrap-select.js when using FilterMultiSelect (silviomoreto.github.io/bootstrap-select) -->
			<script src="{$basePath}/js/bootstrap-select.js"></script>

			<script>

				var Nette = {
					initForm: function () {}
				};

				$(function () {
					$.nette.init();
				});


				$(document).ready(function () {

					$('#sidebarCollapse').on('click', function () {
						$('#sidebar').toggleClass('active');
					});
				$(".selectpicker").selectpicker();
				});

			</script>

			{block scripts}
			{/block}




		</body>
		</html>
