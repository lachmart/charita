<h2>Faktura č. 1712 {$formatedId} {($invoice->created|date:'%W')+1} vystavena dne {$invoice->created|date:'%d. %m. %Y'}</h2>
<hr>

      <table id="udaje_charity" style="width:100%" >
        <tr border="1">
          <th colspan="2" >
            Společnost
          </th>
          <th >

          </th>
          <th >
            Zákazník
          </th>
        </tr>
        <tr>
          <td>
            Název:
          </td>
          <td>
            Charita Olomouc
          </td>
          <td>

          </td>
          <td >
            {$customer->billingFullName}
          </td>
        </tr>
        <tr>
          <td>
            Adresa:
          </td>
          <td>
            Wurmova 5, Olomouc, 779 00
          </td>
          <td>
          </td>
          <td align="right">
            {$customer->billingStreet}
          </td>
        </tr>
        <tr>
          <td>
            Ič:
          </td>
          <td>
            44936427
          </td>
          <td>

          </td>
          <td align="right">
              {$customer->billingZip}  {$customer->billingCity}
          </td>
        </tr>
      </table>



<hr>
<table id="objednavky" style="width:100%;" >
  <tr>
    <th>
      Položky
    </th>
    <th>
      Cena
    </th>
  </tr>
  <tr><td><br></td></tr>
{foreach $orders as $order}
<tr>
  <td>
    Objednávka č. {$order->orderId} ze dne {$order->created|date:'%d. %m. %Y'}
  </td>
  <td align="right">
    {$order->price} kč
  </td>
</tr>
{/foreach}
<tr><td><br></td></tr>
<tr>
  <td>
    <b>Celková částka</b>
  </td>
  <td align="right">
    <b>{$invoice->total} kč</b>
  </td>
</tr>
</table>
