{block customerForm}

	{form customerForm}

		<!-- Jednoduché vykreslení chyb -->
		<div  n:if="$form->hasErrors()">
		    <div class="alert alert-danger" n:foreach="$form->errors as $error">{$error}</div>
		</div>

		<div class="card mb-4">
		  <div class="card-header">
			Údaje o zákazníkovi:
			</div>
			<div style="display:none">
				{label customerId/}
			 {input customerId}
			</div>
		  <div class="card-body">
		  	<div class="row mb-4">
					<div class="col-sm-6">
						{label	billingFullName/}
						{input	billingFullName}
						</div>
						<div class="col-sm-6">
							{label billingStreet/}
							{input billingStreet}
				  	</div>
		  	</div>
				<div class="row mb-4">
					<div class="col-sm-6">

						</div>
						<div class="col-sm-6">
	                    {label	billingCity/}
	                    {input	billingCity}
	                    {label	billingZip/}
	                    {input	billingZip}
				  	</div>
		  	</div>
				<div class="row mb-4">
					<div class="col-sm-6">
											{label email/}
											{input email}
						</div>
						<div class="col-sm-6">
	                    {label	phone/}
	                    {input	phone}
				  	</div>
		  	</div>
				<div class="row mb-4">
					<div class="col-sm-12">
											{label remark/}
											{input remark}
						</div>
		  	</div>

		</div>



		<div class="row mb-5">
			<div class="col-sm-7 offset-sm-5">
                {label submit/}
                {input submit}
								{if $presenter->isLinkCurrent("detail")}
									{label delete/}
		              {input delete}
								{/if}
				<a href="{link Customer:}" class="btn btn-secondary" role="button">Zrušit</a>
			</div>
		</div>
		<div class="row mb-5">
			<div class="col-sm-5 offset-sm-7">
			 {if $showInvoiceCreate}
				 <a href="{link Invoice:Create $customer->customerId}" class="btn btn-primary" role="button" onclick='return confirm("Opravdu chcete vystavit fakturu?")'>Vystavit fakturu</a>
			 {/if}
			 {if isset($customer)}
			 	 <a href="{link Order:Create $customer->customerId}" class="btn btn-primary" role="button">Přidat objednávku</a>
			 {/if}


			</div>
		</div>

	{/form}



{/block}
