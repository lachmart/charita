{block orderForm}

	{form orderForm 20}

		<!-- Jednoduché vykreslení chyb -->
		<div  n:if="$form->hasErrors()">
		    <div class="alert alert-danger" n:foreach="$form->errors as $error">{$error}</div>
		</div>



		<div class="card mb-4">
			<div style="display:none;">
				{label	fk_customer/}
				{input	fk_customer}
			</div>
		  <div class="card-header">
			Údaje o zákazníkovi:
			</div>
			<div style="display:none;">
			{label orderId/}
			{input orderId}


		</div>
		  <div class="card-body">
				<div class="row mb-4">
					<div class="col-sm-12">
											{label list/}
											{input list}
											{label remark/}
											{input remark}

						</div>
				</div>

				<div class="row mb-4">
					<div class="col-sm-6">
											{label price_timestamp/}
											{input price_timestamp}
						</div>
						<div class="col-sm-6">
	                    {label	price/}
	                    {input	price}
				  	</div>
		  	</div>
				<div class="row mb-4">
					<div class="col-sm-6">
											{label customerName/}
											{input customerName}
						</div>
						<div class="col-sm-6">
	                    {label	fk_invoice/}
	                    {input	fk_invoice}
				  	</div>
		  	</div>
				<div class="row mb-4">
					<div class="col-sm-6">

						</div>
						<div class="col-sm-6">
											{label	created/}
											{input	created}
						</div>
				</div>

		</div>



		<div class="row mb-5">
			<div class="col-sm-6 offset-sm-5">
                {label submit/}
                {input submit}
								{if $presenter->isLinkCurrent("detail")}
									{label delete/}
		              {input delete}
								{/if}

				<a href="{if $customerId}{link Customer:}{else}{link Order:}{/if}" class="btn btn-secondary float-right" role="button">Zrušit</a>

			</div>
		</div>

	{/form}



{/block}
