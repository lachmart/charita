  </tr>
  <tr>
    <td>Poznámka 1:</td>
    <td>{$customer->remark}</td>
  </tr>
  <tr>
    <td>Poznámka 2:</td>
    <td>{$order->remark}</td>
  </tr>
  <tr>
    <td>Nákupní seznam:</td>
    <td  ></td>
  </tr>
