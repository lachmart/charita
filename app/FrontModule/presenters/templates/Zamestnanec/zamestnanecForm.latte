{block zamestnanecForm}

	{form zamestnanecForm}

		<!-- Jednoduché vykreslení chyb -->
		<div  n:if="$form->hasErrors()">
		    <div class="alert alert-danger" n:foreach="$form->errors as $error">{$error}</div>
		</div>

		<div class="card mb-4">
		  <div class="card-header">
			Údaje o zaměstnaneci:
			</div>
			<div style="display:none">
				{label zamestnanecId/}
			 {input zamestnanecId}
			</div>
		  <div class="card-body">
		  	<div class="row mb-4">
					<div class="col-sm-6">
						{label	jmeno/}
						{input	jmeno}
						</div>
						<div class="col-sm-6">
							{label osobniCislo/}
							{input osobniCislo}
				  	</div>
		  	</div>
				<div class="row mb-4">
					<div class="col-sm-6">
                        {label	pohlavi/}
	                    {input	pohlavi}
						</div>
						<div class="col-sm-6">

	                    {label	narozeni/}
	                    {input	narozeni}
				  	</div>
		  	</div>
				<div class="row mb-4">
					<div class="col-sm-6">
                        {label zapoctenaPraxe/}
                        {input zapoctenaPraxe}
                    </div>
                    <div class="col-sm-6">
                        {label	nastup/}
                        {input	nastup}
				  	</div>
		  	</div>
				<div class="row mb-4">
					<div class="col-sm-12">
                        {label vzdelani/}
                        {input vzdelani}
                    </div>
		  	    </div>

		</div>



		{* <div class="row mb-5">
			<div class="col-sm-7 offset-sm-5">
                {label submit/}
                {input submit}
								{if $presenter->isLinkCurrent("detail")}
									{label delete/}
		              {input delete}
								{/if}
				<a href="{link Zamestnanec:}" class="btn btn-secondary" role="button">Zrušit</a>
			</div>
		</div>
		<div class="row mb-5">
			<div class="col-sm-5 offset-sm-7">
			 {if $showMzdovyComCreate}
				 <a href="{link MzdovyCom:Create $zamestnanec->zamestnanecId}" class="btn btn-primary" role="button" onclick='return confirm("Opravdu chcete vystavit fakturu?")'>Vystavit fakturu</a>
			 {/if}
			 {if isset($zamestnanec)}
			 	 <a href="{link WR:Create $zamestnanec->zamestnanecId}" class="btn btn-primary" role="button">Přidat objednávku</a>
			 {/if}


			</div>
		</div> *}

	{/form}



{/block}
