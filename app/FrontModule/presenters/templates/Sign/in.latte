{block content}



        <h3 n:block=title class="mb-5">Přihlášení</h3>

            {form signInForm}


                {if $form->hasErrors()}
                <div class="row mt-3 mb-3">
                    <div class="col-md-12 mx-auto">
                        <div class="medium-6 medium-offset-3 columns text-center">
                            <div n:foreach="$form->errors as $error" class="alert alert-danger">{$error}</div>
                        </div><!-- large-8 large-2-offset columns -->
                    </div>
                </div><!-- row -->
                {/if}

            {/form}


        <form n:name=signInForm class="form form-horizontal">
            <div class="w-25">
                <fieldset>
                    <div class="form-group">
                        <div class="control-label"><label for="username">Přihlašovací jméno:</label></div>
                        <div class=""><input type="text" name="username" class="form-control text" id="username"></div>
                    </div>
                    <div class="form-group">
                        <div class="control-label"><label for="password">Heslo:</label></div>
                        <div class=""><input type="password" name="password" class="form-control text" id="password"></div>
                    </div>
                    <div class="form-group">
                        <input n:name=remember id="remember" type="checkbox">
                        <label for="remember">Zapamatovat přihlášení</label>
                    </div>
                    <div class="form-group">
                        <input type="submit" name="send" class="btn btn-primary button" value="Přihlásit se">
                    </div>
                </fieldset>
            </div>
        </form>







{/block}
